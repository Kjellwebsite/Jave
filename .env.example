# ─────────────────────────────────────────────────────────────────────────────
# JAVE environment. Copy to .env and fill in. Never commit .env.
# Every variable is validated at startup (packages/config/src/env.ts).
# See ENVIRONMENT.md for details on each variable.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Database (required: bot + dashboard) ─────────────────────────────────────
DATABASE_URL=postgres://jave:jave@localhost:5432/jave
DATABASE_POOL_MAX=10

# ── Discord application (required: bot + dashboard) ──────────────────────────
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Bot token (bot only). Discord developer portal → Bot → Reset Token.
DISCORD_TOKEN=
# OAuth2 client secret (dashboard login). Required in production.
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs granted FOUNDER on first contact.
JAVE_FOUNDER_DISCORD_IDS=

# ── Dashboard ────────────────────────────────────────────────────────────────
JAVE_PUBLIC_URL=http://localhost:3000
# ≥ 32 random characters: openssl rand -base64 48
JAVE_SESSION_SECRET=
# MOCK / DEVELOPMENT ONLY — password-less persona login. Refused in production.
JAVE_DEV_AUTH=false

# ── Bot process ──────────────────────────────────────────────────────────────
BOT_HEALTH_PORT=8080
JAVE_WORKER_CONCURRENCY=4
JAVE_WORKER_POLL_MS=1000

# ── Secrets at rest (integrations) ───────────────────────────────────────────
# 32 bytes, base64: openssl rand -base64 32
JAVE_ENCRYPTION_KEY=

# ── AI (optional) ────────────────────────────────────────────────────────────
# anthropic | openai | openai-compatible | disabled
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
# Only for openai-compatible providers (DeepSeek, Ollama, LM Studio, vLLM…)
AI_BASE_URL=
AI_DAILY_REQUEST_LIMIT=50

# ── Integrations (optional) ──────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
SIDUS_API_URL=
SIDUS_API_KEY=
