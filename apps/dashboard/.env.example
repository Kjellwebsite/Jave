# JAVE dashboard — copy to .env.local (never commit real values).
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://jave:jave@localhost:5432/jave
DATABASE_POOL_MAX=10

DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Required in production. Without it, "Continue with Discord" is disabled.
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs bootstrapped to FOUNDER on first sign-in.
JAVE_FOUNDER_DISCORD_IDS=

# Public origin of the dashboard. OAuth redirect: <JAVE_PUBLIC_URL>/api/auth/discord/callback
JAVE_PUBLIC_URL=http://localhost:3000
# ≥ 32 random characters: openssl rand -hex 32
JAVE_SESSION_SECRET=
# 32 bytes, base64: openssl rand -base64 32
JAVE_ENCRYPTION_KEY=

# MOCK / DEVELOPMENT ONLY — password-less persona sign-in. The app refuses to boot with this in production.
JAVE_DEV_AUTH=false
