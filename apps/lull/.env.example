# Lull website (apps/lull). Copy to apps/lull/.env.local for local development.

# Stripe secret key for Checkout. Test mode only for now: keys that do not start with
# sk_test_ or rk_test_ are refused. Leave empty and the checkout stays off.
STRIPE_SECRET_KEY=

# Placeholder content from the prototype (invented reviews and ratings, dead links).
# Default: shown locally and on Vercel preview deployments, hidden on production.
# LULL_PLACEHOLDERS=show
# LULL_PLACEHOLDERS=hide

# Canonical origin for metadata. On Vercel the production domain is used when unset.
# NEXT_PUBLIC_SITE_URL=https://lull.example
